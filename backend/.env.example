# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost/tramiteja_development
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Rails Configuration
SECRET_KEY_BASE=your_secret_key_base_here
RAILS_ENV=development

# R2 Cloudflare Storage (Opcional - para upload de documentos)
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=tramiteja-documents-development

# Email Configuration (Opcional - para notificações)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# OAuth Gov.br (Planejado)
# GOVBR_CLIENT_ID=your_govbr_client_id
# GOVBR_CLIENT_SECRET=your_govbr_client_secret
# GOVBR_REDIRECT_URI=http://localhost:3000/auth/govbr/callback

# JWT Configuration
JWT_SECRET=your_jwt_secret_here

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3001

# Performance Monitoring (Opcional)
# NEW_RELIC_LICENSE_KEY=your_newrelic_key
# SENTRY_DSN=your_sentry_dsn