# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Application Configuration
NEXT_PUBLIC_APP_NAME=TrâmiteJá
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=development

# Authentication
NEXT_PUBLIC_JWT_SECRET=your_jwt_secret_here

# OAuth Gov.br (Planejado)
# NEXT_PUBLIC_GOVBR_CLIENT_ID=your_govbr_client_id
# GOVBR_CLIENT_SECRET=your_govbr_client_secret

# File Upload Configuration
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/jpg,image/png

# Performance Monitoring (Opcional)
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id

# Development Only
# NEXT_PUBLIC_API_MOCKING=false
# NEXT_PUBLIC_DEBUG_MODE=true